{
  "name": "mailrun",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun scripts/prepare.ts && bun --bun vite --host 127.0.0.1 --port 3000",
    "db:generate": "bun scripts/prepare.ts && bun bun-sqlgen generate 'src/**/*.ts' --migrations drizzle/migrations --dialect sqlite --out src/queries.gen.ts",
    "db:check": "bun bun-sqlgen generate 'src/**/*.ts' --migrations drizzle/migrations --dialect sqlite --out src/queries.gen.ts --check && bun scripts/check-sql-coverage.ts",
    "typecheck": "bun run check:typescript-version && tsc --noEmit",
    "test": "bun test",
    "check": "bun run db:check && bun run typecheck && bun test",
    "build": "bun scripts/prepare.ts && bun run db:check && bun --bun vite build && bun run typecheck && bun scripts/compile.ts",
    "build:local": "BUILD_TARGET=host bun run build",
    "start": "bun server/index.ts",
    "benchmark": "bun scripts/benchmark.ts",
    "smoke": "bun scripts/smoke.ts",
    "check:typescript-version": "bun scripts/check-typescript-version.ts"
  },
  "dependencies": {
    "@ilbertt/bun-sqlgen": "0.7.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "bcryptjs": "3.0.3",
    "postal-mime": "4.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "seroval": "1.6.11",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "imports": {
    "#start-handler": "./dist/server/server.js"
  }
}
