{
	"name": "mailrun",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"packageManager": "bun@1.4.3",
	"engines": {
		"bun": ">=1.4.3"
	},
	"scripts": {
		"dev": "bun scripts/prepare.ts && bun --bun vite --host 127.0.0.1 --port 3000",
		"db:generate": "bun scripts/prepare.ts && bun bun-sqlgen generate 'src/**/*.ts' --migrations drizzle/migrations --dialect sqlite --out src/queries.gen.ts",
		"db:check": "bun bun-sqlgen generate 'src/**/*.ts' --migrations drizzle/migrations --dialect sqlite --out src/queries.gen.ts --check && bun scripts/check-sql-coverage.ts",
		"typecheck": "bun run check:typescript-version && tsc --noEmit",
		"test": "bun test",
		"check": "bun run db:check && bun run typecheck && bun test",
		"build": "bun scripts/prepare.ts && bun run db:check && bun --bun vite build && bun run typecheck && bun scripts/compile.ts",
		"build:local": "BUILD_TARGET=host bun run build",
		"start": "bun server/index.ts",
		"benchmark": "bun scripts/benchmark.ts",
		"smoke": "bun scripts/smoke.ts",
		"smoke:agent": "bun scripts/smoke-agent.ts",
		"smoke:resend": "bun scripts/smoke-resend.ts",
		"check:typescript-version": "bun scripts/check-typescript-version.ts"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "3.0.55",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@ilbertt/bun-sqlgen": "0.7.0",
		"@modelcontextprotocol/server": "2.1.0",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.1.16",
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-slot": "1.5.0",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-router": "1.170.45",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.3",
		"ai": "7.0.113",
		"bcryptjs": "3.0.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"css-tree": "3.2.1",
		"dompurify": "3.4.17",
		"lucide-react": "1.61.0",
		"parse-srcset": "1.0.2",
		"parse5": "8.0.1",
		"postal-mime": "4.0.11",
		"qrcode": "1.5.4",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hot-toast": "2.6.1",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"safe-regex2": "5.1.2",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "1.4.3",
		"@types/css-tree": "3.2.0",
		"@types/qrcode": "1.5.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "6.1.2",
		"sass": "1.105.0",
		"seroval": "1.6.11",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4"
	},
	"imports": {
		"#start-handler": "./dist/server/server.js"
	}
}
