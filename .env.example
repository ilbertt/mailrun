PORT=3000
DATA_DIR=./data
APP_URL=http://localhost:3000
# Required to claim the first admin through the public setup page.
# Generate with: openssl rand -hex 32
SETUP_TOKEN=
# Required for setup to deploy the email-only relay and connect the first domain.
CF_TOKEN=
# Original Mailflare alternative; when both are set, this pair takes precedence.
# CF_API_KEY=
# CF_EMAIL=
CF_ACCOUNT_ID=
# Cron registration is automatic on nibrun; local development never installs jobs.

# Optional assistant provider; the original Agent screen can store this instead.
# AI_BASE_URL=https://your-compatible-provider/v1
# AI_API_KEY=
# AI_MODEL=your-model-id

# Optional Resend sender/receiver. The original Domains screen can store this.
# RESEND_API_KEY=

# Optional Amazon SES credentials; the original AWS panel can store these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=
